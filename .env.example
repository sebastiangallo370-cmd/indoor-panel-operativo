# Acceso al asistente web
APP_USER=indoor
APP_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA

# Dominio propio produccion.tech (certificado por DNS-01 vía Cloudflare, ver Caddyfile).
#   1. Pasa el DNS de produccion.tech a los nameservers de Cloudflare (gratis).
#   2. Crea un token en https://dash.cloudflare.com/profile/api-tokens con permiso
#      Zone:DNS:Edit, limitado a la zona produccion.tech.
CLOUDFLARE_API_TOKEN=REEMPLAZAR

# Destinos
NAS_CLIENTES_PATH=/mnt/nas/CLIENTES
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/REEMPLAZAR/edit
GOOGLE_SHEETS_GID=0
PEDIDOS_GOOGLE_SHEETS_GID=1514880696
GOOGLE_CREDENTIALS=/run/secrets/google-service-account.json

# Supabase
SUPABASE_URL=https://REEMPLAZAR.supabase.co
SUPABASE_KEY=REEMPLAZAR

# Archivo de control de pagos en Google Drive
PAGOS_COTIZACIONES_FILE_ID=REEMPLAZAR
PAGOS_COTIZACIONES_HOJA=REEMPLAZAR

# Alertas por correo
SMTP_EMAIL=REEMPLAZAR
SMTP_PASSWORD=REEMPLAZAR
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
